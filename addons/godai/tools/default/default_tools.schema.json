{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://snopekgames.com/godai/default_tools.schema.json",
	"title": "Godai Default Tools",
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string"
		},
		"tools": {
			"type": "object",
			"additionalProperties": {
				"type": "object",
				"properties": {
					"title": {
						"type": "string"
					},
					"description": {
						"type": ["string", "array"],
						"items": {
							"type": "string"
						}
					},
					"annotations": {
						"type": "object",
						"properties": {
							"readOnlyHint": {
								"type": "boolean"
							},
							"destructiveHint": {
								"type": "boolean"
							},
							"idempotentHint": {
								"type": "boolean"
							},
							"openWorldHint": {
								"type": "boolean"
							}
						},
						"required": ["readOnlyHint", "openWorldHint"]
					},
					"inputSchema": {
						"$ref": "https://json-schema.org/draft/2020-12/schema"
					},
					"outputSchema": {
						"$ref": "https://json-schema.org/draft/2020-12/schema"
					},
					"doNotForward": {
						"type": "boolean",
						"default": "false"
					}
				},
				"required": ["title", "description", "annotations"],
				"additionalProperties": false
			}
		}
	}
}